{
    "name": "projetos/bibliocrud",
    "description": "Teste Técnico TJJUD 5",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "dompdf/dompdf": "^3.0",
        "twbs/bootstrap": "^5.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:integration": "phpunit --testsuite Integration"
    },
    "config": {
        "sort-packages": true
    },
    "authors": [
        {
            "name": "Antonio Moreira Junior"
        }
    ]
}